{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carina",
  "version": "0.1.1",
  "identifier": "app.carina.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Carina",
        "url": "/",
        "width": 400,
        "height": 132,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "alwaysOnBottom": true,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "m4a",
          "aac",
          "ogg",
          "aif",
          "aiff"
        ],
        "name": "Carina Audio",
        "description": "Аудиофайл",
        "role": "Viewer"
      }
    ],
    "shortDescription": "Лёгкий музыкальный плеер-виджет, by Zhichkin",
    "publisher": "Zhichkin",
    "copyright": "© 2026 Zhichkin",
    "longDescription": "Carina: стеклянный виджет на рабочем столе, свой аудиодвижок, музыкальные папки как плейлисты. by Zhichkin",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
