{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carina",
  "version": "0.1.0",
  "identifier": "app.carina.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Carina",
        "url": "/",
        "width": 400,
        "height": 132,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "alwaysOnBottom": true,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "m4a",
          "aac",
          "ogg",
          "aif",
          "aiff"
        ],
        "name": "Carina Audio",
        "description": "Аудиофайл",
        "role": "Viewer"
      }
    ],
    "shortDescription": "Carina by zhichkin44-del — лёгкий музыкальный плеер-виджет",
    "publisher": "zhichkin44-del",
    "copyright": "© 2026 zhichkin44-del",
    "longDescription": "Carina by zhichkin44-del: стеклянный виджет на рабочем столе, свой аудиодвижок, музыкальные папки как плейлисты."
  }
}
